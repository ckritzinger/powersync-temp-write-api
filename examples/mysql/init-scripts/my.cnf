# PowerSync replicates MySQL from the binary log, which must be enabled and in the right shape
# before the server starts — this cannot be turned on afterwards from a setup script.
[mysqld]
log_bin = mysql-bin
server-id = 1

# Global transaction identifiers let replication resume from a known position.
gtid_mode = ON
enforce_gtid_consistency = ON

# Row-based, full images: PowerSync needs the whole row as it was, not the statement that
# changed it. Anything less and updates replicate incorrectly or not at all.
binlog_format = ROW
binlog_row_image = FULL
