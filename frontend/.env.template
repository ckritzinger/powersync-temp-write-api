# Only needed to run the client on the host with `pnpm dev`. In Docker these are supplied as build
# args by the example overlay, because Vite inlines VITE_* variables at build time.
#
#   cp .env.template .env.local
VITE_BACKEND_URL=http://localhost:6060
VITE_POWERSYNC_URL=http://localhost:8080

# Transaction batching. There is one upload path and one endpoint (POST /api/data), which always
# takes an ordered run of whole transactions; these only bound how much of the queue goes per
# request. Defaults to 10 transactions. Set to 1 for one transaction per round-trip.
# VITE_BATCH_MAX_TRANSACTIONS=10
# Operation ceiling per batch, whichever bound is reached first. Defaults to 1000.
# VITE_BATCH_MAX_OPERATIONS=1000
# `stop` (default) ends the batch at a fatal failure. `skip` drops that transaction and carries on,
# so a queue blocked by a poison operation can still drain.
# VITE_BATCH_ON_FATAL_ERROR=stop

# Abort a write API request (single or batch) that takes longer than this many milliseconds.
# VITE_REQUEST_TIMEOUT_MS=30000
