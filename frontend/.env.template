# Copy this template: `cp .env.local.template .env.local`
# Edit .env.local and enter your project details.
VITE_BACKEND_URL=http://localhost:6060
VITE_POWERSYNC_URL=http://localhost:8080

# Transaction batching. Leave VITE_BATCH_MAX_TRANSACTIONS unset (the default) to upload one
# transaction per attempt via POST /api/data. Set it to a positive integer to accumulate that many
# whole transactions and upload them in one request via POST /api/data/batch.
# VITE_BATCH_MAX_TRANSACTIONS=10
# Operation ceiling per batch, whichever bound is reached first.
# VITE_BATCH_MAX_OPERATIONS=1000
# `stop` (default) ends the batch at a fatal failure. `skip` drops that transaction and carries on,
# so a queue blocked by a poison operation can still drain.
# VITE_BATCH_ON_FATAL_ERROR=stop
